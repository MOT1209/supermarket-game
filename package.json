{
  "name": "fresh-mart-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "FRESH MART v2.0 — a full 3D supermarket simulator built with Three.js and Vite",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "vite": "^5.4.11"
  }
}
